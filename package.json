{
  "name": "gerror",
  "version": "2.0.0-alpha.0",
  "description": "Mixer for gRPC Error & ECMAScript Error",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/esm/src/mod.d.ts",
      "import": "./dist/esm/src/mod.js"
    }
  },
  "types": "./dist/esm/src/mod.d.ts",
  "engines": {
    "node": ">=20",
    "npm": ">=9"
  },
  "scripts": {
    "clean": "shx rm -fr dist/*",
    "build": "tsc",
    "dist": "npm run clean && npm run build",
    "lint": "tsc --noEmit",
    "test:unit": "node --test \"dist/esm/src/**/*.spec.js\" \"dist/esm/tests/**/*.spec.js\"",
    "test": "npm run build && npm run test:unit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huan/gerror.git"
  },
  "keywords": [
    "error",
    "grpc",
    "ecma",
    "status",
    "protocol buffer",
    "dto",
    "isomorphic",
    "wintertc"
  ],
  "author": "Huan LI <zixia@zixia.net>",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/huan/gerror/issues"
  },
  "homepage": "https://github.com/huan/gerror#readme",
  "devDependencies": {
    "@types/node": "^22.10.1",
    "shx": "^0.3.4",
    "typescript": "^5.7.2"
  },
  "dependencies": {},
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next"
  }
}
